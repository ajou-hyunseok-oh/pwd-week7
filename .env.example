# Copy this file to .env in the server root.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Integrations > Data API: use the base URL, without /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co
# Settings > API Keys > Secret keys. Never put this in React/VITE_*.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_real_key

# Run npm run key:generate and paste the generated value here.
# This is an Express admin token, separate from the Supabase secret key.
ADMIN_API_KEY=replace_with_a_random_key_from_npm_run_key_generate

# Comma-separated React origins. Leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
